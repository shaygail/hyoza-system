DATABASE_URL="file:./dev.db"
# For production use PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/ourcloud_service_desk"
AUTH_SECRET="generate-a-secure-random-string"
AUTH_TRUST_HOST=true
# AUTH_URL="https://your-domain.example"  # Set in production only

# Public URL used in customer email links
# PORTAL_BASE_URL="https://support.your-domain.example"

# Customer ticket links (magic links) expire after this many days. Every email
# we send includes a currently valid link.
# GUEST_LINK_TTL_DAYS=30

# Outbound email (SMTP). If SMTP_HOST is unset, emails are logged to the console.
# SMTP_HOST="smtp.your-provider.example"
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Support <support@your-domain.example>"
# MAIL_REPLY_TO="support@your-domain.example"   # should be the IMAP inbox so replies thread

# Inbound email (IMAP). Used by `npm run worker` / `npm run email:worker`.
# Mail is routed to the EmailMailbox whose address is in To/Cc/Delivered-To.
# IMAP_HOST="imap.your-provider.example"
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER="support@your-domain.example"
# IMAP_PASSWORD=""
# IMAP_FOLDER="INBOX"
# IMAP_DEFAULT_MAILBOX="support@your-domain.example"

# Worker loop interval for `npm run worker`
# WORKER_INTERVAL_SECONDS=60
