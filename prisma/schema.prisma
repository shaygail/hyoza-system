generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  organisations  Organisation[]
  teams          Team[]
  workflows      Workflow[]
  ticketTypes    TicketType[]
  priorities     Priority[]
  tickets        Ticket[]
  roles          Role[]
  ticketSequence TicketSequence?
  categories     Category[]
  assets         Asset[]
  queues         Queue[]
  workTypes      WorkType[]
  slaPolicies       SlaPolicy[]
  businessCalendars BusinessCalendar[]
  automationRules   AutomationRule[]
  kbCategories      KbCategory[]
  kbArticles        KbArticle[]
  contracts         Contract[]
  rateCards         RateCard[]
  customFields      CustomFieldDefinition[]
  emailMailboxes    EmailMailbox[]
  billingPeriods    BillingPeriod[]
  invoices          Invoice[]
  xeroConnection    XeroConnection?
  browseSchemes     BrowseScheme[]
  securityAudits    SecurityAuditLog[]
}

model TicketSequence {
  id       String @id @default(cuid())
  tenantId String @unique
  nextVal  Int    @default(1)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  contactId    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact             Contact?            @relation(fields: [contactId], references: [id])
  userRoles           UserRole[]
  teamMembers         TeamMember[]
  assignedTickets     Ticket[]            @relation("TicketAssignee")
  createdTickets      Ticket[]            @relation("TicketCreator")
  comments            TicketComment[]
  internalNotes       TicketInternalNote[]
  internalNoteTags    TicketInternalNoteTag[]
  activities          TicketActivity[]
  uploadedAttachments TicketAttachment[]
  timeEntries         TimeEntry[]
  queuePins           UserQueuePin[]
  notifications       Notification[]
  preferences         UserPreference?
  kbArticles          KbArticle[]
  ticketWatchers      TicketWatcher[] @relation("TicketWatcherUser")
  taggedWatchers      TicketWatcher[] @relation("TicketWatcherTagger")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  code          String
  description   String?
  isSystem      Boolean  @default(false)
  securityLevel Int      @default(1)
  createdAt     DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  browseSchemes   BrowseScheme[]

  @@unique([tenantId, code])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  tickets     Ticket[]
  queues      Queue[]

  @@index([tenantId])
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Organisation {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  accountCode     String?
  status          String   @default("active")
  phone           String?
  email           String?
  address         String?
  notes           String?
  taxId           String?
  billingEmail    String?
  paymentTerms    String?
  xeroContactId   String?
  minSecurityLevel Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  tickets        Ticket[]
  assets         Asset[]
  timeEntries    TimeEntry[]
  contracts      Contract[]
  billingPeriods BillingPeriod[]
  invoices       Invoice[]
  emailMailboxes EmailMailbox[]

  @@index([tenantId])
}

model Contact {
  id             String   @id @default(cuid())
  tenantId       String
  organisationId String
  name           String
  email          String
  phone          String?
  jobTitle       String?
  isPrimary      Boolean  @default(false)
  portalAccess   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?
  tickets      Ticket[]
  ticketComments TicketComment[]

  @@unique([tenantId, email])
  @@index([organisationId])
}

model Workflow {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statuses   WorkflowStatus[]
  transitions WorkflowTransition[]
  ticketTypes TicketType[]

  @@index([tenantId])
}

model WorkflowStatus {
  id         String @id @default(cuid())
  workflowId String
  name       String
  code       String
  category   String
  color      String @default("#6b7280")
  sortOrder  Int    @default(0)
  isTerminal Boolean @default(false)
  pausesSla  Boolean @default(false)

  workflow       Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  transitionsFrom WorkflowTransition[] @relation("FromStatus")
  transitionsTo   WorkflowTransition[] @relation("ToStatus")

  @@unique([workflowId, code])
}

model WorkflowTransition {
  id             String  @id @default(cuid())
  workflowId     String
  fromStatusId   String
  toStatusId     String
  name           String
  sortOrder      Int     @default(0)
  requiredFields String  @default("[]")
  conditions     String  @default("[]")
  actions        String  @default("[]")

  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)
}

model TicketType {
  id               String  @id @default(cuid())
  tenantId         String
  workflowId       String?
  name             String
  code             String
  description      String?
  visibleInPortal  Boolean @default(true)
  sortOrder        Int     @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow? @relation(fields: [workflowId], references: [id])
  tickets  Ticket[]

  @@unique([tenantId, code])
}

model Priority {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  code      String
  color     String @default("#6b7280")
  sortOrder Int    @default(0)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  slaPolicies SlaPolicy[]

  @@unique([tenantId, code])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  tickets      Ticket[]   @relation("TicketCategory")
  subcatTickets Ticket[]  @relation("TicketSubcategory")

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
}

model Asset {
  id                 String   @id @default(cuid())
  tenantId           String
  organisationId     String
  assetTag           String
  name               String
  assetType          String   @default("other")
  status             String   @default("active")
  assignedContactId  String?
  serialNumber       String?
  manufacturer       String?
  model              String?
  operatingSystem    String?
  location           String?
  notes              String?
  externalSource     String?
  externalId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([tenantId, assetTag])
  @@index([organisationId])
}

model Queue {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  filterDefinition String   @default("{}")
  sortBy           String   @default("updatedAt")
  sortDirection    String   @default("desc")
  isSystem         Boolean  @default(false)
  visibility       String   @default("global")
  teamId           String?
  createdById      String?
  createdAt        DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team?          @relation(fields: [teamId], references: [id])
  pins   UserQueuePin[]

  @@index([tenantId])
}

model UserQueuePin {
  userId    String
  queueId   String
  sortOrder Int    @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
}

model WorkType {
  id                String  @id @default(cuid())
  tenantId          String
  name              String
  code              String
  isBillableDefault Boolean @default(true)
  sortOrder         Int     @default(0)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]
  rateCardLines  RateCardLine[]

  @@unique([tenantId, code])
}

model TimeEntry {
  id              String    @id @default(cuid())
  tenantId        String
  ticketId        String
  userId          String
  organisationId  String
  contractId      String?
  billingPeriodId String?
  workTypeId      String?
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int
  isBillable      Boolean   @default(true)
  notes           String?
  status          String    @default("submitted")
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  workType      WorkType?      @relation(fields: [workTypeId], references: [id])
  contract      Contract?      @relation(fields: [contractId], references: [id])
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([organisationId])
  @@index([contractId])
  @@index([status])
}

model BusinessCalendar {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  timezone  String   @default("Europe/London")
  workDays  String   @default("[1,2,3,4,5]")
  startTime String   @default("09:00")
  endTime   String   @default("17:30")
  holidays  String   @default("[]")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slaPolicies SlaPolicy[]

  @@index([tenantId])
}

model SlaPolicy {
  id                 String  @id @default(cuid())
  tenantId           String
  name               String
  priorityId         String
  responseMinutes    Int
  resolutionMinutes  Int
  businessCalendarId String?
  escalationMinutes  Int?
  escalationAction   String  @default("notify")
  isDefault          Boolean @default(false)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priority         Priority          @relation(fields: [priorityId], references: [id])
  businessCalendar BusinessCalendar? @relation(fields: [businessCalendarId], references: [id])
  tickets          Ticket[]

  @@index([tenantId])
}

model SlaPause {
  id        String    @id @default(cuid())
  ticketId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  reason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  trigger     String
  conditions  String   @default("[]")
  actions     String   @default("[]")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KbCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  parentId  String?
  sortOrder Int      @default(0)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   KbCategory?  @relation("KbCategoryTree", fields: [parentId], references: [id])
  children KbCategory[] @relation("KbCategoryTree")
  articles KbArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model KbArticle {
  id          String    @id @default(cuid())
  tenantId    String
  categoryId  String?
  title       String
  slug        String
  body        String
  status      String    @default("draft")
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category KbCategory? @relation(fields: [categoryId], references: [id])
  author   User        @relation(fields: [authorId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Contract {
  id                String    @id @default(cuid())
  tenantId          String
  organisationId    String
  rateCardId        String?
  name              String
  contractType      String    @default("block_hours")
  status            String    @default("draft")
  currency          String    @default("NZD")
  notes             String?
  monthlyMinutes    Int?
  retainerAmount    Float?
  overageHourlyRate Float?
  responseMinutes   Int?
  resolutionMinutes Int?
  minSecurityLevel  Int       @default(1)
  startDate         DateTime  @default(now())
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rateCard       RateCard?       @relation(fields: [rateCardId], references: [id])
  allowances     ContractAllowance[]
  timeEntries    TimeEntry[]
  billingPeriods BillingPeriod[]
  invoices       Invoice[]

  @@index([tenantId])
  @@index([organisationId])
  @@index([status])
}

model ContractAllowance {
  id              String   @id @default(cuid())
  contractId      String
  periodLabel     String
  allowanceMinutes Int
  usedMinutes     Int      @default(0)
  rolloverMinutes Int      @default(0)
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model RateCard {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     RateCardLine[]
  contracts Contract[]

  @@index([tenantId])
}

model RateCardLine {
  id                   String @id @default(cuid())
  rateCardId           String
  workTypeId           String
  hourlyRate           Float
  afterHoursMultiplier Float  @default(1.5)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  workType WorkType @relation(fields: [workTypeId], references: [id])

  @@unique([rateCardId, workTypeId])
}

model BillingPeriod {
  id             String    @id @default(cuid())
  tenantId       String
  organisationId String
  contractId     String
  label          String
  status         String    @default("open")
  startDate      DateTime
  endDate        DateTime
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]
  invoices     Invoice[]

  @@index([tenantId])
  @@index([contractId])
  @@index([status])
}

model Invoice {
  id              String    @id @default(cuid())
  tenantId        String
  organisationId  String
  contractId      String?
  billingPeriodId String?
  invoiceNumber   String
  status          String    @default("draft")
  currency        String    @default("NZD")
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  total           Float     @default(0)
  notes           String?
  xeroInvoiceId   String?
  issuedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contract      Contract?      @relation(fields: [contractId], references: [id])
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id])
  lines         InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([organisationId])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitAmount  Float
  lineTotal   Float
  lineType    String  @default("time")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model XeroConnection {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  tenantName   String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  xeroTenantId String?
  isConnected  Boolean   @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BrowseScheme {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  rules       String   @default("{}")
  roleId      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id])

  @@unique([tenantId, code])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  targetType String
  targetId  String?
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model CustomFieldDefinition {
  id         String  @id @default(cuid())
  tenantId   String
  entityType String  @default("ticket")
  label      String
  code       String
  fieldType  String
  options    String  @default("[]")
  isRequired Boolean @default(false)
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values TicketCustomFieldValue[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TicketCustomFieldValue {
  ticketId String
  fieldId  String
  value    String

  ticket Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field  CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([ticketId, fieldId])
}

model EmailMailbox {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  emailAddress   String
  organisationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id])
  emails       InboundEmail[]

  @@unique([tenantId, emailAddress])
}

model InboundEmail {
  id          String    @id @default(cuid())
  mailboxId   String
  messageId   String
  fromAddress String
  subject     String
  body        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  ticketId    String?
  status      String    @default("pending")

  mailbox EmailMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  ticket  Ticket?      @relation(fields: [ticketId], references: [id])

  @@unique([mailboxId, messageId])
  @@index([status])
}

model TicketGuestAccess {
  id        String   @id @default(cuid())
  ticketId  String
  email     String
  token     String   @unique
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model UserPreference {
  userId          String @id
  dashboardLayout String @default("[\"myOpen\",\"unassigned\",\"slaAtRisk\",\"recent\",\"myTickets\"]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                String    @id @default(cuid())
  tenantId          String
  ticketNumber      String
  subject           String
  description       String
  organisationId    String
  contactId         String?
  assigneeId        String?
  teamId            String?
  statusId          String
  priorityId        String
  ticketTypeId      String
  categoryId        String?
  subcategoryId     String?
  assetId           String?
  slaPolicyId       String?
  source            String    @default("agent")
  tags              String    @default("[]")
  dueAt             DateTime?
  responseDueAt     DateTime?
  resolutionDueAt   DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  resolutionSummary String?
  parentTicketId    String?
  createdById       String
  minSecurityLevel  Int       @default(1)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentTicket Ticket?      @relation("LinkedTickets", fields: [parentTicketId], references: [id])
  linkedTickets Ticket[]    @relation("LinkedTickets")
  organisation Organisation @relation(fields: [organisationId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  status       WorkflowStatus @relation(fields: [statusId], references: [id])
  priority     Priority     @relation(fields: [priorityId], references: [id])
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  category     Category?    @relation("TicketCategory", fields: [categoryId], references: [id])
  subcategory  Category?    @relation("TicketSubcategory", fields: [subcategoryId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  slaPolicy    SlaPolicy?   @relation(fields: [slaPolicyId], references: [id])
  createdBy    User         @relation("TicketCreator", fields: [createdById], references: [id])
  comments         TicketComment[]
  internalNotes    TicketInternalNote[]
  attachments      TicketAttachment[]
  activities       TicketActivity[]
  timeEntries      TimeEntry[]
  slaPauses        SlaPause[]
  customFieldValues TicketCustomFieldValue[]
  inboundEmails    InboundEmail[]
  guestAccess      TicketGuestAccess[]
  watchers         TicketWatcher[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, statusId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, organisationId])
}

model TicketComment {
  id                  String   @id @default(cuid())
  ticketId            String
  authorId            String
  body                String
  onBehalfOfContactId String?
  actingAgentId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author            User     @relation(fields: [authorId], references: [id])
  onBehalfOfContact Contact? @relation(fields: [onBehalfOfContactId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketInternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User                    @relation(fields: [authorId], references: [id])
  tags   TicketInternalNoteTag[]

  @@index([ticketId, createdAt])
}

model TicketInternalNoteTag {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  createdAt DateTime @default(now())

  note TicketInternalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User               @relation(fields: [userId], references: [id])

  @@unique([noteId, userId])
  @@index([userId])
}

model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  taggedById String
  reason    String   @default("escalation")
  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation("TicketWatcherUser", fields: [userId], references: [id])
  taggedBy User   @relation("TicketWatcherTagger", fields: [taggedById], references: [id])

  @@unique([ticketId, userId])
  @@index([userId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
}

model TicketActivity {
  id         String   @id @default(cuid())
  ticketId   String
  actorId    String?
  eventType  String
  payload    String   @default("{}")
  visibility String   @default("internal")
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}
